# Public Vite env vars (must be prefixed with VITE_)
VITE_APP_NAME="SideQuest"
VITE_APP_ENV="development"

# Dev server
VITE_PORT=5173

# API — full base URL (swap for staging/prod by changing this single value)
VITE_API_URL="http://localhost:3000/api/v1"
VITE_API_TIMEOUT=15000
# Send cookies/credentials with cross-origin requests (NestJS must enable CORS w/ credentials)
VITE_API_WITH_CREDENTIALS=true

# Map provider: "leaflet" | "mapbox"
VITE_MAP_PROVIDER="leaflet"
VITE_MAP_DEFAULT_LAT=50.0875
VITE_MAP_DEFAULT_LNG=14.4213
VITE_MAP_DEFAULT_ZOOM=13

# Optional Mapbox token (only used when VITE_MAP_PROVIDER="mapbox")
VITE_MAPBOX_TOKEN=""

# Feature flags
VITE_ENABLE_DEVTOOLS=true
